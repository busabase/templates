{
  "name": "Evidence Register",
  "description": "One row per piece of evidence — what it is, where it came from, and whether anyone has verified it. The register is the desk's memory of what is actually known, as opposed to what has merely been said.",
  "position": 2,
  "agentPrompts": [
    {
      "key": "register-evidence",
      "label": "Register evidence from a document",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then register the document I name in Evidence: type, source, source date, and a summary of what it establishes. Mark it Unverified unless it is itself a primary source (a filing, an audited statement) — and say which in the summary."
    },
    {
      "key": "verify-evidence",
      "label": "Verify a piece of evidence",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then verify the evidence I name against its primary source: check the figures and claims it carries, then update its verification status — Verified only if the primary source says the same thing, Contradicted if it does not — and note what you checked in the summary."
    },
    {
      "key": "unverified-list",
      "label": "What is still unverified?",
      "intent": "read-only",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then list everything in Evidence still marked Unverified for the target I name, oldest first — these are the facts the IC memo may not state as facts. Do not change anything."
    }
  ],
  "fields": [
