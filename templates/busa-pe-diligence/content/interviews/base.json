{
  "name": "Interviews & Site Visits",
  "description": "Management calls, expert calls, customer references and site visits — what was claimed, by whom, and whether the evidence agrees. Everything said here is a claim until Evidence says otherwise.",
  "position": 4,
  "agentPrompts": [
    {
      "key": "log-interview",
      "label": "Log an interview or site visit",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then log the interview or visit I describe: who said what, the key claims in their words, and a first consistency mark of Not yet tested. Claims stay claims — do not upgrade anything to a fact here."
    },
    {
      "key": "testimonial-check",
      "label": "Check an interview against the evidence",
      "intent": "read-only",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then check the interview I name against the evidence register: which of its claims the evidence supports, which it contradicts, and which are still untested. Do not change anything."
    }
  ],
