{
  "name": "Diligence Requests",
  "description": "The diligence request list — every document, analysis and check the team has asked for, grouped by workstream, with what is still missing and who is chasing it. This is the desk's main battlefield.",
  "position": 1,
  "agentPrompts": [
    {
      "key": "build-request-list",
      "label": "Build the request list for a target",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then build the diligence request list for the target I name: the standard PE list across all nine workstreams, critical items first, each with who it is requested from and a due date. Mark anything a listed or seller-side source can already answer from public filings."
    },
    {
      "key": "what-is-missing",
      "label": "What are we still missing?",
      "intent": "read-only",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then show me everything still missing for the target I name: requests still Requested or Blocked, critical ones first, with due dates and who owns each chase. Do not change anything."
    },
    {
      "key": "log-received",
      "label": "Log material that just arrived",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then log the material I describe as received: move the matching requests to Received, and register each document in Evidence as Unverified until someone has checked it against a primary source."
    }
  ],
