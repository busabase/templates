  "position": 0,
  "agentPrompts": [
    {
      "key": "open-diligence",
      "label": "Open diligence on a company",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then open a diligence project for the company I name: add it to Targets at the Screening stage, note the deal type, target stake and indicative enterprise value, and generate its first diligence request list across all nine workstreams. Do not contact the company or anyone outside this workspace."
    },
    {
      "key": "pipeline-brief",
      "label": "Brief me on the pipeline",
      "intent": "read-only",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then brief me on the pipeline: every target with its stage, what is blocking it, and the next IC date. Do not change anything."
    },
    {
      "key": "ready-for-ic",
      "label": "What stands between this target and IC?",
      "intent": "read-only",
      "body": "Read the `busa-pe-diligence` skill in this folder and follow its workflow, then tell me what stands between the target I name and the investment committee: critical requests still open, findings still open, and anything still unverified that the IC memo would have to carry as a caveat."
    }
