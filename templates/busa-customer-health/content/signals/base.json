{
  "name": "Signals",
  "description": "One row every time something about an account moves — usage, urgent tickets, NPS, billing or the relationship — with the evidence and which agent or person wrote it.",
  "position": 1,
  "agentPrompts": [
    {
      "key": "log-signal",
      "label": {
        "en": "Log what I just heard from a customer",
        "zh-CN": "记下我刚从客户那里听到的情况"
      },
      "body": {
        "en": "Read the `busa-customer-health` skill in this folder and follow it. Record what I tell you about the account I name as one signal: the kind, today’s date, me as the writer and the evidence in my words. If it changes one of the five signal fields, update that field and re-score the account.",
        "zh-CN": "先阅读本文件夹里的 `busa-customer-health` Skill，按它的规则做。把我说的关于某个客户的情况记成一条信号：类型、今天的日期、写入者是我、依据用我的原话。如果它改变了五个信号字段之一，更新那个字段并给客户重新打分。"
      },
      "intent": "change"
    },
    {
      "key": "what-moved",
      "label": {
        "en": "What moved this week, and who wrote it?",
        "zh-CN": "这周哪些信号变了，是谁写的"
      },
      "body": {
        "en": "Read the `busa-customer-health` skill in this folder and follow it. Summarise the signals of the last seven days by account, worst account first: what moved, by how much, and which agent or person wrote each one. Do not change anything.",
        "zh-CN": "先阅读本文件夹里的 `busa-customer-health` Skill，按它的规则做。按客户汇总最近七天的信号，最差的客户排前面：变了什么、变了多少、每条是哪个 Agent 或哪个人写的。不要修改任何记录。"
      },
      "intent": "read-only"
    }
  ],
