          "assets/screenshots/mobile-detail-zh-CN.webp",
          "assets/screenshots/needs-review-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/workbench-zh-CN.webp"
        ]
      }
