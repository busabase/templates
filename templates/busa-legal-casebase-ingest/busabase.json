{
  "format": "busabase-package@1",
  "name": "busa-legal-casebase-ingest",
  "displayName": {
    "en": "Busa Legal Casebase Ingest",
    "zh-CN": "Busa 案例录入"
  },
  "description": {
    "en": "Casebase intake and anonymization desk for law-firm judgments and arbitral awards: agent-prepared case records, canonical case-library groupings, and deterministic QA checks that turn documents into a searchable case library",
    "zh-CN": "面向律所判决书与仲裁裁决文书的案例库录入与脱敏台：Agent 整理好的案例记录、规范化的案例库分组，以及把文书变成可检索案例库的规则化质检。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "legal",
    "risk:local-write",
    "industry:legal",
    "surface:busabase"
  ],
  "template": {
    "category": "legal",
    "schemaVersion": 1,
    "airapp": "busa-legal-casebase-ingest-app",
    "tags": [
      "legal",
      "risk:local-write",
      "industry:legal",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/checks.webp",
      "assets/screenshots/entities.webp",
      "assets/screenshots/mobile-detail.webp",
      "assets/screenshots/needs-review.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/workbench.webp"
    ],
    "video": "assets/recordings/busa-legal-casebase-ingest.mp4",
    "locales": {
