{
  "format": "busabase-package@1",
  "name": "busa-listing",
  "displayName": {
    "en": "Busa Listing",
    "zh-CN": "Busa 商品详情页"
  },
  "description": {
    "en": "Listing factory: a product library, listing drafts for each platform, compliance checks for banned words and claims, and a registry of the claims you can use",
    "zh-CN": "商品详情页生产台：商品库、各平台详情页草稿、禁用词与卖点合规检查，以及可放心使用的卖点主张库。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "ecommerce",
    "risk:gated-write",
    "industry:ecommerce",
    "surface:busabase"
  ],
  "template": {
    "category": "ecommerce",
    "schemaVersion": 1,
    "airapp": "busa-listing-app",
    "tags": [
      "ecommerce",
      "risk:gated-write",
      "industry:ecommerce",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/checks.webp",
      "assets/screenshots/claims.webp",
      "assets/screenshots/drafts.webp",
      "assets/screenshots/needs-review.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/products.webp"
    ],
    "video": "assets/recordings/busa-listing.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/checks-zh-CN.webp",
          "assets/screenshots/claims-zh-CN.webp",
          "assets/screenshots/drafts-zh-CN.webp",
          "assets/screenshots/needs-review-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/products-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the latest Products and flag what needs my attention.",
      "Draft Amazon and TikTok Shop listings for this product and run the compliance checks."
    ],
    "requires": {
      "airapp": true
    }
  }
}
