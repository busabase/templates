{
  "format": "busabase-package@1",
  "name": "busa-crm",
  "displayName": {
    "en": "Busa CRM",
    "zh-CN": "Busa 客户管理"
  },
  "description": {
    "en": "A CRM for contacts, companies, deals and interactions, where your agent logs every touchpoint and drafts the next follow-up",
    "zh-CN": "联系人、公司、成交机会与沟通记录集于一处，Agent 记下每次接触并起草跟进。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "sales-crm",
    "risk:gated-write",
    "surface:busabase"
  ],
  "template": {
    "category": "sales-crm",
    "schemaVersion": 1,
    "airapp": "busa-crm-app",
    "tags": [
      "sales-crm",
      "risk:gated-write",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/contacts.webp",
      "assets/screenshots/deals.webp",
      "assets/screenshots/followups.webp",
      "assets/screenshots/overview.webp"
    ],
    "video": "assets/recordings/busa-crm.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/contacts-zh-CN.webp",
          "assets/screenshots/deals-zh-CN.webp",
          "assets/screenshots/followups-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the pipeline and flag which deals need my attention this week.",
      "Draft follow-ups for the contacts I met this week, based on our last conversations."
    ],
    "requires": {
      "airapp": true
    }
  }
}
