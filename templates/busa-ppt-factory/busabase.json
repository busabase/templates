{
  "format": "busabase-package@1",
  "name": "busa-ppt-factory",
  "displayName": {
    "en": "Busa PPT Factory",
    "zh-CN": "Busa PPT工厂"
  },
  "description": {
    "en": "Project-based PPTX production desk: projects, decks, slide cards, style systems, QA checks, and generated PPTX exports",
    "zh-CN": "基于项目的 PPTX 生产台：项目、演示文稿、幻灯片卡片、样式体系、质检，以及生成的 PPTX 导出文件。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "production",
    "risk:local-write",
    "surface:busabase"
  ],
  "template": {
    "category": "production",
    "schemaVersion": 1,
    "airapp": "busa-ppt-factory-app",
    "tags": [
      "production",
      "risk:local-write",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/decks.webp",
      "assets/screenshots/exports.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/projects.webp",
      "assets/screenshots/review.webp",
      "assets/screenshots/slides.webp",
      "assets/screenshots/style.webp"
    ],
    "video": "assets/recordings/busa-ppt-factory.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/decks-zh-CN.webp",
          "assets/screenshots/exports-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/projects-zh-CN.webp",
          "assets/screenshots/review-zh-CN.webp",
          "assets/screenshots/slides-zh-CN.webp",
          "assets/screenshots/style-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the latest Projects and flag what needs my attention.",
      "Start a new deck from this outline in our style kit and draft the slide cards."
    ],
    "requires": {
      "airapp": true
    }
  }
}
