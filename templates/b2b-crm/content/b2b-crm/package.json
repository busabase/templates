{
  "name": "b2b-crm",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build:sdk": "esbuild scripts/sdk-entry.js --bundle --format=esm --platform=browser --minify-whitespace --outfile=app/vendor/busabase-sdk.js && node scripts/normalize-bundle.mjs",
