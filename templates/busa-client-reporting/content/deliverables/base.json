{
  "name": "Deliverables",
  "description": "One row per promised deliverable: which project it belongs to, where it stands, and when the client got it. Notes are internal and never appear on the client report page.",
  "position": 2,
  "agentPrompts": [
    {
      "key": "add-deliverable",
      "label": "Add a deliverable to a project",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then add the deliverable I describe to the project I name, with its due date. Set the client from the project unless I say otherwise."
    },
    {
      "key": "mark-deliverable-sent",
      "label": "Mark a deliverable as sent to the client",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then mark the deliverable I name as Sent to Client with today's delivered date and the link I give you. Do not send anything to the client yourself — recording that it was sent is the whole job."
    },
    {
      "key": "deliverables-awaiting-client",
      "label": "What is waiting on each client?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then list deliverables in Sent to Client or Revision Requested, grouped by client, with due dates. Keep internal notes out of the list."
    }
  ],
