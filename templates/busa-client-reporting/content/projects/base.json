{
  "name": "Projects",
  "description": "One row per engagement for a client: service type, status, dates and a plain-language summary. Owner is internal and never appears on the client report page.",
  "position": 1,
  "agentPrompts": [
    {
      "key": "start-project",
      "label": "Start a project for a client",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then create the project I describe under the client I name: service type, start and due dates, and a one-paragraph summary written the way we would show it to the client."
    },
    {
      "key": "update-project-status",
      "label": "Update a project's status",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then update the status of the project I name to match what I describe, and refresh its summary if the scope changed. Owner is internal — never copy it into the summary."
    },
    {
      "key": "projects-at-risk",
      "label": "Which projects are at risk?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then list the projects marked At Risk or On Hold, with their client, due date and summary. Do not change anything."
    }
  ],
  "fields": [
    {
      "slug": "project-name",
      "name": "Project Name",
      "type": "text",
      "required": true,
      "position": 0,
      "options": {}
