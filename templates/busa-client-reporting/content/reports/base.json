{
  "name": "Reports",
  "description": "One row per client report for one period: the narrative the client reads (executive summary, highlights, next steps) and its sharing status. Risks & Blockers are internal and never appear on the client report page.",
  "position": 5,
  "agentPrompts": [
    {
      "key": "draft-report",
      "label": "Draft a report for a client and period",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then draft the report for the client and period I name from that period's deliverables, KPI snapshots and milestones: executive summary, highlights and next steps in client-safe language, risks and blockers kept in the internal field only. Leave the status in Draft."
    },
    {
      "key": "mark-report-shared",
      "label": "Mark a report as shared and log it",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then mark the report I name as Shared and write into Shared Link Note where the read-only share link was sent and when, exactly as I tell you. The share link itself is created on the node in Busabase — never invent a URL."
    },
    {
      "key": "reports-ready-to-share",
      "label": "Which reports are ready to share?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then list the reports in Ready to Share, with client and period, and remind me of the sharing steps: create the read-only share link on the node, send it outside the app, then mark the report Shared."
    }
  ],
