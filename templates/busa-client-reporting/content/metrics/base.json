{
  "name": "KPI Snapshots",
  "description": "One row per KPI reading for one client and period: the value, the previous value and the target. Change versus previous and versus target is computed by the app — never store a computed percentage here. Notes are internal.",
  "position": 3,
  "agentPrompts": [
    {
      "key": "record-kpi-snapshot",
      "label": "Record this period's KPI numbers",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then record the KPI numbers I give you for the client and period I name: value, previous value, target, unit and source. Use only the numbers I give you — never estimate, carry over or invent a figure."
    },
    {
      "key": "kpi-movers",
      "label": "Which KPIs moved most this period?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then show me, for the client and period I name, each KPI's change versus its previous value and versus its target, biggest movers first. The change is computed — do not write it back as a field."
    },
    {
      "key": "missing-kpis",
      "label": "Which clients are missing KPI snapshots?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then tell me which active clients have no KPI snapshot for the period I name. Do not change anything."
    }
  ],
