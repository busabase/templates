{
  "name": "Clients",
  "description": "One row per agency client: who they are, who to contact, and how often they get a report. Notes are internal and never appear on the client report page.",
  "position": 0,
  "agentPrompts": [
    {
      "key": "add-client",
      "label": "Add a new client",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then add the client I describe: name, primary contact, contact email, industry, status and reporting cadence. Leave anything I did not tell you empty — do not guess an email address."
    },
    {
      "key": "client-picture",
      "label": "Give me the full picture of one client",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then summarise the client I name: their projects and statuses, open deliverables, latest KPI snapshots and the status of their latest report. Keep internal notes out of the summary unless I ask for them."
    },
    {
      "key": "pause-or-close-client",
      "label": "Pause or close out a client",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then set the client I name to Paused or Former Client as I describe, and tell me which of their projects and reports are still open."
    }
  ],
