{
  "name": "Milestones",
  "description": "One row per milestone on a project: due date, completion date and status. These render as the timeline on the client report page.",
  "position": 4,
  "agentPrompts": [
    {
      "key": "add-milestone",
      "label": "Add a milestone to a project",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then add the milestone I describe to the project I name, with its due date. Set the client from the project unless I say otherwise."
    },
    {
      "key": "complete-milestone",
      "label": "Mark a milestone as done",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder and follow its workflow, then mark the milestone I name as Done with the completion date I give you (today if I do not name one)."
    },
    {
      "key": "milestone-timeline",
      "label": "Show a project's milestone timeline",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-client-reporting` skill in this folder, then show the milestones for the project I name in due-date order, marking which are done, in progress, upcoming or missed."
    }
  ],
  "fields": [
