{
  "name": "busa-ads",
  "private": true,
  "type": "module",
  "version": "0.1.1",
  "description": "Busa Ads Busabase Cloud skill and trusted report-ingest/checks/execute scripts.",
  "scripts": {
    "ingest": "node scripts/ingest_reports.mjs",
    "checks": "node scripts/run_checks.mjs",
    "execute": "node scripts/execute_decisions.mjs",
    "app:check": "pnpm --dir content/busa-ads-app check",
    "check:bundle": "node scripts/sync-skill-runtime.mjs --check",
    "test:installed": "node --test test/sample-records.test.mjs test/installed-skill.test.mjs"
  },
  "dependencies": {
    "busabase-sdk": "0.30.1"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
