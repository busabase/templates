{
  "name": "Objectives",
  "description": "What the company and each team want to achieve this quarter.",
  "position": 0,
  "agentPrompts": [
    {
      "key": "draft-okrs",
      "label": {
        "en": "Draft next quarter’s objectives from our plan",
        "zh-CN": "根据年度计划起草下季度目标"
      },
      "body": {
        "en": "Read the `busa-okr` skill in this folder and follow it. Draft company and team objectives for the quarter I name from the plan or notes I paste: three company objectives at most, each team objective supporting one of them, each with two to four measurable key results. Show me the draft before writing anything.",
        "zh-CN": "先阅读本文件夹里的 `busa-okr` Skill，按它的规则做。根据我贴的计划或笔记，为我指定的季度起草公司级和团队级目标：公司级最多三个，每个团队目标都要支撑其中一个，每个目标配两到四个可量化的关键结果。写入前先给我看草稿。"
      },
      "intent": "change"
    },
    {
      "key": "objective-status",
      "label": {
        "en": "How is this objective really doing?",
        "zh-CN": "这个目标实际进展如何"
      },
      "body": {
        "en": "Read the `busa-okr` skill in this folder and follow it. For the objective I name, show each key result with its progress against where the quarter says it should be, the latest update and who wrote it, and any open actions. Do not change anything.",
        "zh-CN": "先阅读本文件夹里的 `busa-okr` Skill，按它的规则做。针对我说的目标，列出每个关键结果的进度和按时间应达到的进度、最近一次更新及写入者，以及未完成的行动。不要修改任何记录。"
      },
      "intent": "read-only"
    }
  ],
