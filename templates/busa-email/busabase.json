{
  "format": "busabase-package@1",
  "name": "busa-email",
  "displayName": {
    "en": "Busa Email",
    "zh-CN": "Busa 邮件台"
  },
  "description": {
    "en": "Inbox-zero desk: your agent triages unread mail across your accounts, drafts replies, and carries out the archive, mark-read and send actions you decide on.",
    "zh-CN": "收件箱清零工作台：Agent 跨账号分拣未读邮件、起草回复，并按你的决定执行归档、标记已读与发送。"
  },
  "version": "0.3.0",
  "license": "MIT",
  "tags": [
    "email",
    "triage",
    "approval"
  ],
  "template": {
    "category": "email",
    "schemaVersion": 3,
    "airapp": "busa-email-app",
    "tags": [
      "inbox",
      "review-queue",
      "drafts"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/inbox-approval.webp",
      "assets/screenshots/needs-review.webp",
      "assets/screenshots/blocked-security.webp"
    ],
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/inbox-approval-zh-CN.webp",
          "assets/screenshots/needs-review-zh-CN.webp",
          "assets/screenshots/blocked-security-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Triage this morning's mail and draft replies for anything high priority.",
      "List the drafted replies that are ready to send, newest first.",
      "Summarise what changed in the inbox since yesterday."
    ],
    "vaultNamespace": "busa-email",
    "secrets": [
      {
        "key": "BUSA_EMAIL_IMAP_PASSWORD_PRIMARY",
        "description": "IMAP password for the primary mailbox",
        "required": true
      },
      {
        "key": "BUSA_EMAIL_SMTP_PASSWORD_PRIMARY",
        "description": "SMTP password for the primary mailbox",
        "required": false
      }
    ],
    "requires": {
      "airapp": true
    }
  }
}
