{
  "format": "busabase-package@1",
  "name": "busa-writer",
  "displayName": {
    "en": "Busa Writer",
    "zh-CN": "Busa 内容工坊"
  },
  "description": {
    "en": "Channel-ready content desk: turn one source into drafts for every channel, then export a publish-ready pack",
    "zh-CN": "面向各渠道的内容工坊：把一份素材改写成各渠道草稿，再导出可直接发布的内容包。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "marketing",
    "risk:gated-write",
    "surface:busabase"
  ],
  "template": {
    "category": "marketing",
    "schemaVersion": 1,
    "airapp": "busa-writer-app",
    "tags": [
      "marketing",
      "risk:gated-write",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/distribution.webp",
      "assets/screenshots/main.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/topics.webp"
    ],
    "video": "assets/recordings/busa-writer.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/distribution-zh-CN.webp",
          "assets/screenshots/main-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/topics-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the latest Drafts and flag what needs my attention.",
      "Turn this article into drafts for LinkedIn, X and our newsletter."
    ],
    "requires": {
      "airapp": true
    }
  }
}
