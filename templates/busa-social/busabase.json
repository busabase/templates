{
  "format": "busabase-package@1",
  "name": "busa-social",
  "displayName": {
    "en": "Busa Social",
    "zh-CN": "Busa 社媒指挥台"
  },
  "description": {
    "en": "Social media command desk: cross-platform monitoring plus an ECHO publishing desk",
    "zh-CN": "社交媒体指挥台：跨平台监测，外加基于 ECHO 方法的发布工作台。"
  },
