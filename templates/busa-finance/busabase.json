{
  "format": "busabase-package@1",
  "name": "busa-finance",
  "displayName": {
    "en": "Busa Finance",
    "zh-CN": "Busa 财务模型"
  },
  "description": {
    "en": "Three-statement financial model desk: the current model snapshot (company, currency, periods, workbook) and model-quality checks such as balance-sheet ties, cash roll-forward and formula checks",
    "zh-CN": "三表联动财务模型工作台：当前模型快照（公司/币种/期间/工作簿）与模型质量检查，如资产负债表勾稽、现金滚存与公式检查。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "finance",
    "risk:local-write",
    "surface:busabase"
  ],
  "template": {
    "category": "finance",
    "schemaVersion": 1,
    "airapp": "busa-finance-app",
    "tags": [
      "finance",
      "risk:local-write",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/checks.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/workbook.webp"
    ],
    "video": "assets/recordings/busa-finance.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/checks-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/workbook-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the latest Model and flag what needs my attention.",
      "Build a three-statement model from these assumptions and check that the balance sheet ties."
    ],
    "requires": {
      "airapp": true
    }
  }
}
