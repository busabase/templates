{
  "format": "busabase-package@1",
  "name": "busa-clm",
  "displayName": {
    "en": "Busa CLM",
    "zh-CN": "Busa 合同管理"
  },
  "description": {
    "en": "Lightweight contract lifecycle desk: contract inventory, lifecycle stage, owners, obligations, renewal and notice dates, and sign-off reminders, so nothing lapses unnoticed. For clause-level redlines, see busa-legal-contracts.",
    "zh-CN": "轻量级合同生命周期台：合同台账、生命周期阶段、责任人、履约义务、续约与到期通知日期，以及签批提醒，不让任何合同悄悄过期。条款级红线修订请用 busa-legal-contracts。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "legal",
    "risk:gated-write",
    "industry:legal",
    "surface:busabase"
  ],
  "template": {
    "category": "legal",
    "schemaVersion": 1,
    "airapp": "busa-clm-app",
    "tags": [
      "legal",
      "risk:gated-write",
      "industry:legal",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/approvals.webp",
      "assets/screenshots/contracts.webp",
      "assets/screenshots/obligations.webp",
      "assets/screenshots/overview.webp",
      "assets/screenshots/renewals.webp"
    ],
    "video": "assets/recordings/busa-clm.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/approvals-zh-CN.webp",
          "assets/screenshots/contracts-zh-CN.webp",
          "assets/screenshots/obligations-zh-CN.webp",
          "assets/screenshots/overview-zh-CN.webp",
          "assets/screenshots/renewals-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the latest Contracts and flag what needs my attention.",
      "List the renewals and notice deadlines coming up in the next 60 days, with the owner for each."
    ],
    "requires": {
      "airapp": true
    }
  }
}
