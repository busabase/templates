{
  "name": "Findings & Red Flags",
  "description": "What diligence has found: each finding states the claim being tested, what the evidence actually shows, its severity, and its impact on valuation, terms or the decision. Every finding must link to evidence.",
  "position": 3,
  "agentPrompts": [
    {
      "key": "raise-finding",
      "label": "Raise a finding from this mismatch",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then raise a finding from the mismatch I describe: state the claim being tested, what the evidence shows, and link the evidence rows behind it. Set severity by the skill's rubric and leave the status Open — do not soften it into a conclusion the evidence does not support."
    },
    {
      "key": "red-flag-wall",
      "label": "Show me the red-flag wall",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then show me every open finding across the desk, ordered Critical first, with the target, the claim being tested, and what would resolve each one. Do not change anything.",
      "intent": "read-only"
    },
    {
      "key": "ic-blockers",
      "label": "Which findings block this target's IC?",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then list the findings that block the target I name from going to IC: open Critical and High findings, the evidence behind each, and the terms or information that would clear them. Do not change anything.",
      "intent": "read-only"
    }
  ],
