{
  "name": "Diligence Requests",
  "description": "The request list: every document, dataset and answer the desk has asked a target for, grouped by workstream, with criticality, owner side and status. This is where diligence is won or stalled.",
  "position": 1,
  "agentPrompts": [
    {
      "key": "build-request-list",
      "label": "Build the request list for a target",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then build the diligence request list for the target I name, by workstream: audited or management financials and burn, cap table and prior-round terms, team and vesting, market evidence, product and tech review, traction cohorts, legal basics. Mark the items that gate IC as Critical."
    },
    {
      "key": "chase-overdue",
      "label": "Which requests are overdue or blocked?",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then list every request that is overdue or blocked across the desk, grouped by target, with the workstream and how long it has been waiting. Do not contact anyone — this desk never chases the company itself.",
      "intent": "read-only"
    },
    {
      "key": "mark-received",
      "label": "Log evidence that just arrived",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then log the material I describe as received: set the matching requests to Received, and register each document in the Evidence Register with its source and date, still Unverified until it has been checked."
    }
  ],
