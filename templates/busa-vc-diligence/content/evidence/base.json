{
  "name": "Evidence Register",
  "description": "Every piece of evidence the desk relies on, with its source, its date, and its verification status. A claim becomes a fact only when a row here says Verified.",
  "position": 2,
  "agentPrompts": [
    {
      "key": "register-evidence",
      "label": "Register this evidence",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then register the document or source I describe in the Evidence Register: what it is, who produced it, its date, the target and request it answers, and a one-paragraph summary of what it actually shows. Leave it Unverified unless I say it has been checked."
    },
    {
      "key": "unverified-sweep",
      "label": "What are we still relying on unverified?",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then list every evidence item still marked Unverified or Contradicted, grouped by target, and name the finding or thesis point that depends on each one. Do not change anything.",
      "intent": "read-only"
    },
    {
      "key": "check-a-claim",
      "label": "Check this claim against the evidence",
      "body": "Read the `busa-vc-diligence` skill in this folder and follow its workflow, then take the claim I quote and check it against the Evidence Register for that target: which items support it, which contradict it, and which are still unverified. Report the claim's status; do not upgrade it to a fact on your own."
    }
  ],
