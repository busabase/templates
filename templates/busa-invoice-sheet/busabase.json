{
  "format": "busabase-package@1",
  "name": "busa-invoice-sheet",
  "displayName": {
    "en": "Busa Invoice Sheet",
    "zh-CN": "Busa 发票台账"
  },
  "description": {
    "en": "Turn invoices, receipts, credit notes and statements into one clean table: extraction batches, field confidence, line items, and export-ready rows",
    "zh-CN": "把发票、收据、贷记通知单和对账单整理成一张干净的表：批量提取、字段置信度、明细行，以及可直接导出的记录。"
  },
  "version": "0.1.0",
  "license": "MIT",
  "tags": [
    "finance",
    "risk:local-write",
    "surface:busabase"
  ],
  "template": {
    "category": "finance",
    "schemaVersion": 1,
    "airapp": "busa-invoice-sheet-app",
    "tags": [
      "finance",
      "risk:local-write",
      "surface:busabase"
    ],
    "screenshots": [
      "assets/screenshots/cover.webp",
      "assets/screenshots/detail-mobile.webp",
      "assets/screenshots/detail.webp",
      "assets/screenshots/extract-data.webp",
      "assets/screenshots/overview-mobile.webp",
      "assets/screenshots/overview.webp"
    ],
    "video": "assets/recordings/busa-invoice-sheet.mp4",
    "locales": {
      "zh-CN": {
        "screenshots": [
          "assets/screenshots/cover-zh-CN.webp",
          "assets/screenshots/detail-mobile.webp",
          "assets/screenshots/detail-zh-CN.webp",
          "assets/screenshots/extract-data-zh-CN.webp",
          "assets/screenshots/overview-mobile.webp",
          "assets/screenshots/overview-zh-CN.webp"
        ]
      }
    },
    "agentPrompts": [
      "Summarize the latest Invoices and flag what needs my attention.",
