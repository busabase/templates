{
  "name": "Reports",
  "description": "One row per daily shop check: what the agent found in Products, Certificates, Orders and on the live site, and the owner's feedback. The next check reads that feedback, applies it, and records what it changed in Applied feedback.",
  "position": 2,
  "agentPrompts": [
    {
      "key": "run-daily-check",
      "label": "Run today's shop check",
      "body": "Read the `busa-shop` skill in this folder and follow its \"Daily shop check\" procedure: first read my feedback on the previous report and apply it, then check products, certificates, orders and the live site, and write one new report. Do not fix product data yourself; list what needs fixing."
    },
    {
      "key": "summarize-open-reports",
      "label": "What did the shop checks find?",
      "body": "Read the `busa-shop` skill in this folder, then summarize the open reports, newest first: the issues found, which are new since the report before, and whether my feedback has been applied.",
      "intent": "read-only"
    },
    {
      "key": "give-feedback",
      "label": "Record my feedback on the latest report",
      "body": "Read the `busa-shop` skill in this folder, then write the feedback I give you into Owner feedback on the latest report, word for word. Do not apply it now; the next daily check applies it."
    }
  ],
  "fields": [
    {
      "slug": "title",
      "name": "Report",
      "type": "text",
      "required": false,
      "position": 0,
      "options": {}
    },
    {
      "slug": "report-date",
      "name": "Date",
      "type": "date",
      "required": true,
      "position": 1,
      "options": {}
    },
    {
      "slug": "status",
      "name": "Status",
      "type": "select",
      "required": true,
      "position": 2,
      "options": {
        "choices": [
          {
            "id": "open",
            "name": "Open"
          },
          {
            "id": "acknowledged",
            "name": "Acknowledged"
          }
        ]
      }
    },
    {
      "slug": "summary",
      "name": "Summary",
      "type": "longtext",
      "required": false,
      "position": 3,
      "options": {}
    },
    {
      "slug": "issue-types",
      "name": "Issue types",
      "type": "multiselect",
      "required": false,
      "position": 4,
      "options": {
        "choices": [
          {
            "id": "missing-image",
            "name": "Missing image"
          },
          {
            "id": "missing-price",
            "name": "Missing price"
          },
          {
            "id": "hidden-product",
            "name": "Product not listed"
          },
          {
            "id": "certificate-missing",
            "name": "Certificate missing"
          },
          {
            "id": "certificate-expiring",
            "name": "Certificate expiring"
          },
          {
            "id": "certificate-expired",
            "name": "Certificate expired"
          },
          {
            "id": "site-unreachable",
            "name": "Site unreachable"
          },
          {
            "id": "site-mismatch",
            "name": "Site differs from data"
          },
          {
            "id": "orders-waiting",
            "name": "Orders waiting"
          }
        ]
      }
    },
    {
      "slug": "issue-count",
      "name": "Issue count",
      "type": "number",
      "required": false,
      "position": 5,
      "options": {}
    },
    {
      "slug": "issues",
      "name": "Issues found",
      "type": "longtext",
      "required": false,
      "position": 6,
      "options": {}
    },
    {
      "slug": "orders-waiting",
      "name": "Orders waiting",
      "type": "number",
      "required": false,
      "position": 7,
      "options": {}
    },
    {
      "slug": "site-check",
      "name": "Live site check",
      "type": "longtext",
      "required": false,
      "position": 8,
      "options": {}
    },
    {
      "slug": "owner-feedback",
      "name": "Owner feedback",
      "type": "longtext",
      "required": false,
      "position": 9,
      "options": {}
    },
    {
      "slug": "applied-feedback",
      "name": "Applied feedback",
      "type": "longtext",
      "required": false,
      "position": 10,
      "options": {}
    },
    {
      "slug": "checked-at",
      "name": "Checked at",
      "type": "date",
      "required": false,
      "position": 11,
      "options": {
        "date": {
          "includeTime": true
        }
      }
    }
  ],
  "views": [
    {
      "slug": "open-reports",
      "name": "Open reports",
      "type": "table",
      "config": {
        "filters": [
          {
            "fieldSlug": "status",
            "operator": "equals",
            "value": "open"
          }
        ],
        "sorts": [
          {
            "fieldSlug": "report-date",
            "direction": "desc"
          }
        ],
        "visibleFieldSlugs": [
          "title",
          "report-date",
          "issue-count",
          "issue-types",
          "orders-waiting",
          "owner-feedback"
        ]
      }
    },
    {
      "slug": "all-reports",
      "name": "All reports",
      "type": "table",
      "config": {
        "filters": [],
        "sorts": [
          {
            "fieldSlug": "report-date",
            "direction": "desc"
          }
        ]
      }
    }
  ]
}
