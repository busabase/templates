{
  "name": "Reports",
  "description": "One row per daily shop check: what the agent found in Products, Certificates, Orders and on the live site, and the owner's feedback. The next check applies feedback on every open report, marks it acknowledged, and records what it changed in Applied feedback. The one row with Sample report ticked is the template's example.",
  "position": 4,
  "agentPrompts": [
    {
      "key": "run-daily-check",
      "label": "Run today's shop check",
      "body": "Read the `busa-shop` skill in this folder and follow its \"Daily shop check\" procedure: first apply my open feedback (on the sample report too) and mark those reports acknowledged, then check products, certificates, orders, demo leftovers and the live site, and write today's report. Do not fix product data yourself; list what needs fixing."
    },
    {
      "key": "summarize-open-reports",
      "label": "What did the shop checks find?",
      "body": "Read the `busa-shop` skill in this folder, then summarize the open reports, newest first: the issues found, which are new since the report before, and whether my feedback has been applied.",
      "intent": "read-only"
    },
    {
      "key": "give-feedback",
      "label": "Record my feedback on the latest report",
      "body": "Read the `busa-shop` skill in this folder, then write the feedback I give you into Owner feedback on the latest report, word for word. Do not apply it now; the next daily check applies it."
    }
  ],
  "fields": [
