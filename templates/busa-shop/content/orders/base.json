{
  "name": "Orders",
  "description": "Order requests from the shop website, one row per order. The website writes a new row with status `new` and never changes it afterwards; staff move it through confirmed → paid → shipped (or cancelled). Internal note and reply draft are staff-only: the website never reads or writes them.",
  "position": 2,
  "agentPrompts": [
    {
      "key": "handle-new-orders",
      "label": "Handle today's new orders",
      "body": "Read the `busa-shop` skill in this folder and follow its \"Handle a new order\" procedure for every order with status `new`: check the items against the product list and stock, write a reply draft for me to send, and tell me what each order needs. Do not email the customer and do not change an order to paid or shipped yourself."
    },
    {
      "key": "orders-waiting",
      "label": "Which orders are waiting on me?",
      "body": "Read the `busa-shop` skill in this folder, then list orders that are still `new` or `confirmed`, oldest first, with how long each has been waiting and what the next step is.",
      "intent": "read-only"
    },
    {
      "key": "mark-order-status",
      "label": "Move an order to its next status",
      "body": "Read the `busa-shop` skill in this folder, then change the status of the order I name to the status I give (confirmed, paid, shipped or cancelled) and add a dated line to its internal note saying who asked for the change. Only do this when I tell you the step really happened."
    }
  ],
