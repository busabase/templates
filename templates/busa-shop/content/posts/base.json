  "agentPrompts": [
    {
      "key": "plan-posts",
      "label": {
        "en": "Plan blog posts that answer what buyers ask",
        "zh-CN": "策划博客文章（回答买家真正会问的问题）"
      },
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-shop` skill in this folder and follow \"Blog posts and landing content (博客文章)\", \"Plan posts\": propose 3 posts that answer questions buyers in the countries this shop ships to really ask before they buy. For each one give the title, the question it answers, the Path, the products it links to and the facts from my tables it will use. Write nothing yet; ask me which one to write."
    },
    {
      "key": "write-draft",
      "label": {
        "en": "Write a blog post draft",
        "zh-CN": "写博客草稿"
      },
      "body": "{target}\n\nRead the `busa-shop` skill in this folder and follow \"Blog posts and landing content (博客文章)\", \"Write a draft\": write the post I chose as ONE new row with Status Draft, using only facts from this shop's Products, Shipping, Settings and Pages. Never set Status to Published, never promise free shipping or a global warranty, and tell me where to read the draft and that I publish it myself."
    },
    {
      "key": "check-draft",
      "label": {
        "en": "Check a draft before I publish it",
        "zh-CN": "发布前检查草稿"
      },
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-shop` skill in this folder and follow \"Blog posts and landing content (博客文章)\", \"Check a draft\": compare every price, spec, shipping cost, delivery time and warranty or return promise in the draft I name with my tables and Pages, and list each one that does not match, plus a missing SEO title, SEO description or excerpt. Change nothing."
    }
  ]
}
