    "agentPrompts": [
        {
            "key": "add-character",
            "label": "Add a new character to the cast",
            "body": "{target}\n\nRead the `busa-mv` skill in this folder and follow its workflow, then add the character I describe: a stable character id, role, three-view visual notes (front/side/back), wardrobe, consistency anchors, and forbidden drift. Leave anything I did not tell you empty rather than inventing detail."
        },
        {
            "key": "update-character-visuals",
            "label": "Update a character's visual details or wardrobe",
            "body": "{target}\n\nRead the `busa-mv` skill in this folder and follow its workflow, then update the visual notes, wardrobe, anchors, or forbidden-drift for the character I name. Do not touch their reference-card status — that only changes through generation."
        },
        {
            "key": "missing-reference-cards",
            "label": "Which characters are missing reference cards?",
            "intent": "read-only",
            "body": "{target}\n\nRead the `busa-mv` skill in this folder, then list the cast members without a generated reference card. Storyboard shots for those characters will fall back to text-to-image and their likeness will drift until a card exists."
        }
    ]
