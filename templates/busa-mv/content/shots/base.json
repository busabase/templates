    "agentPrompts": [
        {
            "key": "add-shot",
            "label": "Add a new shot to the storyboard",
            "body": "{target}\n\nRead the `busa-mv` skill in this folder and follow its workflow, then add the shot I describe: scene description, which cast members are on screen (by character id, not name), and a duration. An AI-generated shot's duration must be exactly 4, 5, 6, 8, 10, or 12 seconds; uploaded clips can be any length."
        },
        {
            "key": "update-shot",
            "label": "Update a shot's description or duration",
            "body": "{target}\n\nRead the `busa-mv` skill in this folder and follow its workflow, then update the description, negative prompt, video prompt, or duration for the shot I name. Do not overwrite an already-uploaded image or video — generated and uploaded candidates are both kept, and the user picks the active one."
        },
        {
            "key": "shots-needing-media",
            "label": "Which shots still need images or videos?",
            "intent": "read-only",
            "body": "{target}\n\nRead the `busa-mv` skill in this folder, then list the shots that are missing an image or a video, in storyboard order, so I know what to generate or upload next."
        }
    ]
