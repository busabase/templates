  "agentPrompts": [
    {
      "key": "discover-and-score-creators",
      "label": "Sweep and fit-score creator candidates",
      "body": "{target}\n\nRead the `busa-creators` skill in this folder and follow its workflow, then sweep the candidates from the niche, brand brief, competitor, or list I give you, upsert them by stable creator id, and compute the C\u00b3 ACE `fit-score` and `fit-breakdown` for each."
    },
    {
      "key": "draft-outreach",
      "label": "Draft outreach or a brief for a creator",
      "body": "{target}\n\nRead the `busa-creators` skill in this folder and follow its workflow, then draft the outreach message or brief I ask for as `suggested-reply` with status \"needs_review\", add money/contract risk badges and an `est-rate`. This only drafts the message \u2014 it never sends it; sending happens through another skill only after I approve it here."
    },
    {
      "key": "revise-after-feedback",
      "label": "Revise an outreach draft that got changes requested",
      "body": "{target}\n\nRead the `busa-creators` skill in this folder, then revise the `suggested-reply` for the creator I name per the review comment, and set its status back to \"needs_review\"."
    },
    {
      "key": "top-candidates",
      "label": "Who are the top fit-scored candidates?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-creators` skill in this folder, then list the top candidates by C\u00b3 ACE fit-score, with platform, niche, followers, and engagement rate. Prefer fit score over raw follower count."
    },
    {
      "key": "outreach-queue-status",
      "label": "What needs review in the outreach queue?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-creators` skill in this folder, then show me the engagements and content-review quality gates waiting for a decision, and flag any gate verdict that is FIX or BLOCK (missing FTC disclosure or unsupportable claims)."
    }
  ]
}
