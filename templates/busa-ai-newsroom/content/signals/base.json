  "position": 0,
  "agentPrompts": [
    {
      "key": "signals-needing-review",
      "label": "What signals need my review?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-ai-newsroom` skill in this folder, then show me today's signals awaiting a decision, with their evidence link, why-it-matters, buyer-intent interpretation, and confidence."
    },
    {
      "key": "explain-signal",
      "label": "Why does this signal matter?",
      "intent": "read-only",
      "body": "{target}\n\nRead the `busa-ai-newsroom` skill in this folder, then explain the signal I name: its source evidence, why it matters to the buyer, and its suggested action, so I understand it before deciding."
    },
    {
      "key": "decide-signal",
      "label": "Record my decision on this signal",
      "body": "{target}\n\nRead the `busa-ai-newsroom` skill in this folder and follow its workflow, then write the verdict I give — approve, request changes with a comment, or block — directly onto the signal I name. This only records the decision; it never posts, publishes, or performs an external handoff."
    }
  ],
