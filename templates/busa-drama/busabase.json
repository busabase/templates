{
  "format": "busabase-package@1",
  "name": "busa-drama",
  "description": "Short-drama workspace: series bible, characters, relationships, episodes, and storyboard shots",
  "version": "0.1.0",
  "license": "MIT",
  "tags": ["production", "risk:local-write", "surface:busabase", "surface:moonrouter", "surface:byteplus-ark"],
